    Default = false,
})

--========================================================--
-- SERVICES + SETUP
--========================================================--
repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local powerValue = player:WaitForChild("Backpack"):WaitForChild("ActionValues"):WaitForChild("Power")

local previousPower = powerValue.Value
local hasTriggered = false
local shotType = nil
local dunkType = nil
local currentEvent = nil

-- PERFECT GREEN POWER VALUES
local shotTargetPower = {
    ["Standing Shot"] = 63,
    ["Moving Shot"] = 69,
    ["Close Floater"] = 67,
    ["Floater"] = 67,
    ["Layup"] = 66,
    ["Standing Layup"] = 66,
    ["Reverse Layup"] = 67.5,
    ["Close Layup"] = 68,
    ["Moving Dunk"] = 67.5,
    ["Standing Dunk"] = 67.5,
    ["Close Post Fade"] = 71,
    ["Post Fade"] = 71
}

--========================================================--
-- AUTO GREEN LOGIC
--========================================================--
local __namecall
__namecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if method == "FireServer" and #args >= 2 then
        if args[1] == true then
            if args[3] and type(args[3]) == "string" and shotTargetPower[args[3]] then
                shotType = args[3]
                dunkType = nil
                hasTriggered = false
                previousPower = powerValue.Value
                currentEvent = self
            elseif args[2] and type(args[2]) == "string" and shotTargetPower[args[2]] then
                dunkType = args[2]
                shotType = nil
                hasTriggered = false
                previousPower = powerValue.Value
                currentEvent = self
            end
        end
    end
    return __namecall(self, ...)
end)

powerValue.Changed:Connect(function(newValue)
    if not Toggles.AutoGreen.Value then
        previousPower = newValue
        return
    end

    local increasing = newValue > previousPower
    local currentShot = shotType or dunkType

    if currentShot and not hasTriggered and increasing and currentEvent then
        local target = shotTargetPower[currentShot]

        if newValue >= target then
            hasTriggered = true
            if dunkType then
                currentEvent:FireServer(false, dunkType, 1)
            elseif shotType then
                currentEvent:FireServer(false, "Shooting", shotType)
            end
        end
    end

    if newValue < previousPower and newValue <= 20 then
        shotType = nil
        dunkType = nil
        hasTriggered = false
        currentEvent = nil
    end

    previousPower = newValue
end)

