--========================================================--
-- SERVICES + SETUP
--========================================================--
repeat task.wait() until game:IsLoaded()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local powerValue = player:WaitForChild("Backpack"):WaitForChild("ActionValues"):WaitForChild("Power")
local hasTriggered = false
local shotType = nil
local dunkType = nil
local currentEvent = nil
local lastPower = powerValue.Value
-- Flag so only the script can fire the release
local scriptFiring = false
-- PERFECT GREEN POWER VALUES
local shotTargetPower = {
    ["Standing Shot"]   = 68,
    ["Moving Shot"]     = 62,
    ["Close Floater"]   = 58,
    ["Floater"]         = 62,
    ["Layup"]           = 62,
    ["Standing Layup"]  = 60,
    ["Reverse Layup"]   = 65,
    ["Close Layup"]     = 65,
    ["Moving Dunk"]     = 65,
    ["Standing Dunk"]   = 65,
    ["Close Post Fade"] = 65,
    ["Post Fade"]       = 62
}
--========================================================--
-- AUTO GREEN LOGIC
--========================================================--
local __namecall
__namecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if method == "FireServer" and #args >= 2 then
        -- Detect start of shot / dunk
        if args[1] == true then
            if args[3] and type(args[3]) == "string" and shotTargetPower[args[3]] then
                shotType = args[3]
                dunkType = nil
                hasTriggered = false
                currentEvent = self
            elseif args[2] and type(args[2]) == "string" and shotTargetPower[args[2]] then
                dunkType = args[2]
                shotType = nil
                hasTriggered = false
                currentEvent = self
            end
        end
        -- Block the game from releasing (args[1] == false) only when Auto Green is enabled
        if args[1] == false and not scriptFiring and Toggles.AutoGreen.Value then
            return
        end
    end
    return __namecall(self, ...)
end)
-- Heartbeat loop
RunService.Heartbeat:Connect(function()
    if not Toggles.AutoGreen.Value then
        lastPower = powerValue.Value
        return
    end
    local currentPower = powerValue.Value
    local currentShot = shotType or dunkType
    if currentShot and not hasTriggered and currentEvent then
        local target = shotTargetPower[currentShot] - Options.Offset.Value
        if currentPower >= target then
            hasTriggered = true
            -- Allow only the script to fire
            scriptFiring = true
            if dunkType then
                currentEvent:FireServer(false, dunkType, 1)
            elseif shotType then
                currentEvent:FireServer(false, "Shooting", shotType)
            end
            scriptFiring = false
        end
    end
    -- Reset when power drops
    if currentPower < lastPower and currentPower <= 20 then
        shotType = nil
        dunkType = nil
        hasTriggered = false
        currentEvent = nil
    end
    lastPower = currentPower
end)
